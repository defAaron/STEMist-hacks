# HoneyDesk API — copy to .env and adjust for local development
# Never commit a real .env file (gitignored).

# development | production (production disables /docs and requires SIMULATE_TOKEN)
APP_ENV=development
EXPOSE_API_DOCS=true
REQUIRE_SIMULATE_TOKEN=false

# Database (required in production)
DATABASE_URL=sqlite:///./data/honeydesk.db

# Comma-separated exact frontend/decoy origins (no trailing slash)
CORS_ORIGINS=http://localhost:3000

# Replay endpoint protection (required on public deployments)
SIMULATE_TOKEN=dev-only-change-me

# Auth session lifetime (days) for Bearer tokens
SESSION_TTL_DAYS=7
PASSWORD_MIN_LENGTH=8

# Trust X-Forwarded-* headers from Render/reverse proxy
TRUST_PROXY=true

# Prefer cached/fallback briefs; set false to allow live LLM when a key is present
BRIEF_FAILOVER_CACHE=true

# Optional live LLM briefs (HTTPS endpoint only)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Request and dependency timeouts (seconds)
REQUEST_TIMEOUT_SECONDS=30
LLM_TIMEOUT_SECONDS=4
SQLITE_TIMEOUT_SECONDS=5
SQLITE_BUSY_RETRIES=3

# Rate limits (requests per IP per minute)
RATE_LIMIT_CAPTURE_PER_MINUTE=30
RATE_LIMIT_SIMULATE_PER_MINUTE=10
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_WINDOW_SECONDS=60

# Redirect HTTP to HTTPS when X-Forwarded-Proto is http (enable on Render)
FORCE_HTTPS=false
