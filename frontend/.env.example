# HoneyDesk frontend — copy to .env.local
# Never commit a real .env.local file (gitignored).

# Backend API base URL (no trailing slash)
# Local: http://127.0.0.1:8000
# Deployed: https://honeydesk-api.onrender.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Must match backend SIMULATE_TOKEN for replay buttons
NEXT_PUBLIC_SIMULATE_TOKEN=dev-only-change-me
